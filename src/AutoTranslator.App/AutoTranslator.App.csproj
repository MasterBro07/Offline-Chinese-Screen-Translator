<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK target gives access to the WinRT APIs (Windows.Media.Ocr, ...) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is only used for the tray icon (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Explicit usings: WPF and WinForms share many type names (Application, MessageBox, ...) -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AutoTranslator</AssemblyName>
    <RootNamespace>AutoTranslator.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>AutoTranslator</Product>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
    <!-- DPI awareness is declared in app.manifest on purpose (WPF app, WinForms only for the tray) -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core hosts the localhost WebSocket bridge on Kestrel; needed here for self-contained publish -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/AutoTranslator.App.SmokeTests runs the internal capture/OCR/overlay classes on a real desktop -->
    <InternalsVisibleTo Include="AutoTranslator.App.SmokeTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoTranslator.Core\AutoTranslator.Core.csproj" />
  </ItemGroup>

</Project>
