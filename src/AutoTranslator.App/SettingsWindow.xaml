<Window x:Class="AutoTranslator.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoTranslator – Einstellungen"
        Width="620" Height="760" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Einstellungen" />
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF555555"
                           Text="Änderungen gelten sofort und werden automatisch gespeichert." />

                <!-- Engine -->
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" Text="Womit soll übersetzt werden?" />
                <RadioButton x:Name="EngineChromeRadio" GroupName="Engine" Margin="0,8,0,0"
                             Click="OnEngineClick">
                    <TextBlock TextWrapping="Wrap" Text="Chrome (kostenlos, auf diesem PC)" />
                </RadioButton>
                <RadioButton x:Name="EngineClaudeRadio" GroupName="Engine" Margin="0,8,0,0"
                             Click="OnEngineClick">
                    <TextBlock TextWrapping="Wrap"
                               Text="Claude Haiku (bessere Qualität, kostet wenig Geld, Text wird an Anthropic gesendet)" />
                </RadioButton>
                <TextBlock x:Name="EngineNoteText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF555555"
                           Text="" />

                <!-- API key -->
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,22,0,0" Text="API-Schlüssel für Claude" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Für Claude wird ein eigener API-Schlüssel von Anthropic gebraucht. So bekommt man ihn: auf console.anthropic.com anmelden → „API Keys“ → neuen Schlüssel erstellen und hier einfügen. Auf dem Anthropic-Konto muss Guthaben vorhanden sein (unter „Billing“ aufladen)." />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="KeyBox" Grid.Column="0" Padding="6" VerticalContentAlignment="Center" />
                    <Button x:Name="SaveKeyButton" Grid.Column="1" Content="Speichern" Margin="8,0,0,0"
                            Padding="12,4" Click="OnSaveKeyClick" />
                    <Button x:Name="RemoveKeyButton" Grid.Column="2" Content="Entfernen" Margin="8,0,0,0"
                            Padding="12,4" Click="OnRemoveKeyClick" />
                </Grid>
                <TextBlock x:Name="KeyStateText" TextWrapping="Wrap" Margin="0,6,0,0" Text="" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF555555"
                           Text="Der Schlüssel wird verschlüsselt nur auf diesem PC und nur für dieses Windows-Benutzerkonto gespeichert. Er wird nie angezeigt und nicht in der Chrome-Erweiterung abgelegt." />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="TestButton" Content="Verbindung testen" Padding="12,4" Click="OnTestClick" />
                </StackPanel>
                <TextBlock x:Name="TestResultText" TextWrapping="Wrap" Margin="0,6,0,0" Text="" />

                <!-- Daily limit -->
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,22,0,0" Text="Tageslimit (Kostenbremse)" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="So viele chinesische Zeichen dürfen pro Tag höchstens an Claude gesendet werden:" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="LimitBox" Width="140" Padding="6" VerticalContentAlignment="Center"
                             MaxLength="15" KeyDown="OnLimitKeyDown" />
                    <TextBlock Text="Zeichen pro Tag" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button x:Name="LimitApplyButton" Content="Übernehmen" Margin="12,0,0,0" Padding="12,4"
                            Click="OnLimitApplyClick" />
                </StackPanel>
                <TextBlock x:Name="LimitStateText" TextWrapping="Wrap" Margin="0,6,0,0" Text="" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF555555"
                           Text="Standard: 300.000 Zeichen pro Tag – das sind nur wenige Cent. 0 bedeutet: kein Limit. Ist das Limit erreicht, übersetzt bis zum nächsten Tag automatisch wieder Chrome (kostenlos). Bereits übersetzte Texte werden gemerkt und kosten nichts mehr." />
                <TextBlock x:Name="UsageText" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" Text="" />

                <!-- Merge lines -->
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,22,0,0" Text="Darstellung" />
                <CheckBox x:Name="MergeLinesCheck" Margin="0,8,0,0" Click="OnMergeLinesClick">
                    <TextBlock TextWrapping="Wrap" Text="Zeilen zu Absätzen zusammenfassen" />
                </CheckBox>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF555555"
                           Text="Mehrzeilige Texte werden als ein Absatz übersetzt. Das klingt meist natürlicher. Ausschalten, wenn Übersetzungen an der falschen Stelle erscheinen." />

                <!-- Privacy -->
                <Border Background="#FFFFF8E1" BorderBrush="#FFE0C36A" BorderThickness="1" CornerRadius="4"
                        Padding="10" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Datenschutz" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Mit Claude wird der gesamte chinesische Text, der im aktiven Fenster (bzw. auf dem Hauptbildschirm) sichtbar ist, über das Internet an die Firma Anthropic gesendet – auch Namen, Adressen, Chat-Nachrichten oder Bestelldaten, wenn sie gerade zu sehen sind. Das gilt ebenso für chinesische Webseiten in Chrome, solange dieses Programm mit Claude läuft. Mit Chrome bleibt alles auf diesem PC." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Schließen" HorizontalAlignment="Right" Margin="0,14,0,0"
                Padding="18,6" IsCancel="True" Click="OnCloseClick" />
    </Grid>
</Window>
