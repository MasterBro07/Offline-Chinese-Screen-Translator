<Window x:Class="AutoTranslator.Desktop.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoTranslator – Einrichtung / Hilfe"
        Width="640" Height="720" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="AutoTranslator einrichten" />
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="AutoTranslator erkennt chinesischen Text auf dem Bildschirm und blendet die englische Übersetzung automatisch direkt darüber ein – ohne Klick. Die Übersetzung erledigt Google Chrome kostenlos auf diesem Computer. Dafür sind einmalig drei Schritte nötig:" />

                <Border Background="#FFF3F6FA" BorderBrush="#FFC9D4E0" BorderThickness="1" CornerRadius="4"
                        Padding="10" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Aktueller Zustand" />
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,4,0,0" Text="…" />
                    </StackPanel>
                </Border>

                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0"
                           Text="1. Chrome-Erweiterung installieren" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="• Den Ordner der Erweiterung (aus dem Download „AutoTranslator-chrome-extension“) an einen festen Ort entpacken." />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="• In Chrome die Adresse chrome://extensions öffnen." />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="• Oben rechts den „Entwicklermodus“ einschalten." />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="• Auf „Entpackte Erweiterung laden“ klicken und den entpackten Ordner auswählen." />

                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0"
                           Text="2. Sprachpaket in Chrome laden" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="• In Chrome auf das Symbol der Erweiterung klicken (eventuell zuerst auf das Puzzle-Symbol)." />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="• Im kleinen Fenster auf „Sprachpaket laden“ klicken und warten, bis es fertig ist. Das ist nur einmal nötig." />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="• Chrome muss geöffnet bleiben, solange übersetzt werden soll." />

                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0"
                           Text="3. Chinesische Texterkennung (OCR) für Windows installieren" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Weg A – über die Einstellungen: Einstellungen → Zeit und Sprache → Sprache und Region → Sprache hinzufügen → Chinesisch (vereinfacht). Die Anzeigesprache von Windows muss dabei nicht geändert werden." />
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Weg B – per Befehl: Rechtsklick auf den Start-Knopf → „Terminal (Administrator)“ bzw. „Windows PowerShell (Administrator)“, dann diesen Befehl einfügen und mit Enter bestätigen:" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CommandBox" Grid.Column="0" IsReadOnly="True" FontFamily="Consolas"
                             FontSize="13" Padding="6" TextWrapping="Wrap" VerticalContentAlignment="Center" />
                    <Button x:Name="CopyButton" Grid.Column="1" Content="Kopieren" Margin="8,0,0,0"
                            Padding="12,4" Click="OnCopyClick" />
                </Grid>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Danach AutoTranslator beenden und neu starten." />

                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0"
                           Text="Optional: bessere Übersetzung mit Claude Haiku" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Im Menü des Symbols gibt es den Punkt „Einstellungen…“. Dort kann statt Chrome der Übersetzer Claude Haiku von Anthropic eingeschaltet werden. Er übersetzt meist deutlich besser, braucht aber einen eigenen API-Schlüssel, kostet etwas Geld (etwa 0,03 Cent pro Bildschirm, mit einstellbarem Tageslimit) und sendet den sichtbaren chinesischen Text an Anthropic. Die Schritte 1 bis 3 bleiben trotzdem nötig; Chrome springt ein, wenn Claude nicht erreichbar ist." />

                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" Text="Bedienung" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="• AutoTranslator läuft als Symbol im Infobereich neben der Uhr (eventuell hinter dem Pfeil „^“). Rechtsklick auf das Symbol öffnet das Menü." />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="• Strg+Alt+T schaltet die Übersetzung jederzeit ein oder aus. Falls ein anderes Programm dieses Tastenkürzel schon benutzt, steht das oben unter „Aktueller Zustand“; dann bitte das Menü verwenden." />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="• „Texterkennung“: OCR liest alles, was auf dem Bildschirm zu sehen ist. UI-Automation liest Texte direkt aus Programmen (genauer, funktioniert aber nicht überall). „Beides“ kombiniert die zwei Wege." />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="• „Bereich“: nur das aktive Fenster (schneller) oder der ganze Hauptbildschirm." />

                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" Text="Grenzen dieser ersten Version" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="• Die Übersetzung erscheint mit etwa 0,5 bis 1 Sekunde Verzögerung." />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="• Die Texterkennung macht Fehler, besonders bei sehr kleiner Schrift oder unruhigem Hintergrund." />
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="• Spiele im exklusiven Vollbildmodus und kopiergeschützte Inhalte (z. B. manche Videos) können nicht gelesen werden." />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Schließen" HorizontalAlignment="Right" Margin="0,14,0,0"
                Padding="18,6" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
    </Grid>
</Window>
