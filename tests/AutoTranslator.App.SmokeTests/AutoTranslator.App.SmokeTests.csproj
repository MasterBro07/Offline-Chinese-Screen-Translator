<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Smoke / integration tests that run the real desktop app code on a real Windows desktop
    (GitHub Actions windows runner, see .github/workflows/smoke.yml). Plain console exe, no
    test framework: the checks need one STA UI thread, a helper process and strict ordering.
    Not part of AutoTranslator.sln on purpose (Windows only); build it by project path.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AutoTranslator.App.SmokeTests</AssemblyName>
    <RootNamespace>AutoTranslator.SmokeTests</RootNamespace>
    <!-- Same DPI awareness as the app, otherwise coordinates would not be comparable -->
    <ApplicationManifest>..\..\src\AutoTranslator.App\app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoTranslator.App\AutoTranslator.App.csproj" />
  </ItemGroup>

</Project>
